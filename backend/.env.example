# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB connection string (replace with your own — never commit real credentials)
MONGO_URI=mongodb://127.0.0.1:27017/marked

# Allowed frontend origin for CORS + cookies (credentials)
CORS_ORIGIN=http://localhost:3000

# Auth (replace with a long random secret in production — never commit real secrets)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Cookie settings (Secure=true and sameSite=none when serving over HTTPS)
COOKIE_SECURE=false

# Payment sandbox provider — shared secret for signing/verifying test webhooks (HMAC-SHA256)
SANDBOX_WEBHOOK_SECRET=sandbox-change-me

# Max JSON request body size (exposed via express.json({ limit }))
JSON_BODY_LIMIT=1mb